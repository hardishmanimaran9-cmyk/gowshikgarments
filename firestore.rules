rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /enquiries/{id} {
      allow create: if true;
      allow read, update: if request.auth != null;
      allow delete: if false;
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
